{
  "openapi": "3.1.0",
  "info": {
    "title": "Nivult Job Postings & Company Intelligence",
    "version": "1.0.0",
    "description": "Live job postings from employer ATS systems and public employment portals, plus company records. Jobs support full-text search over titles and descriptions. Company records are keyed by ATS + company_slug. Coverage and provenance are exposed for documented, selected fields. Direct API clients authenticate with X-Api-Key; RapidAPI authentication is handled by the RapidAPI proxy.",
    "contact": { "name": "Nivult", "url": "https://nivult.com", "email": "hello@nivult.com" }
  },
  "servers": [{ "url": "https://api.nivult.com" }],
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/v1/jobs": {
      "get": {
        "summary": "Search live job postings",
        "operationId": "jobs",
        "description": "Active postings with keyset pagination. q requires all search terms in the title or description; q_any matches at least one of up to 15 comma-separated keywords. Keyword filters accept comma-separated values. Unknown query parameters are ignored. Unknown filter values normally produce an empty page rather than a validation error.",
        "parameters": [
          { "name": "country", "in": "query", "schema": { "type": "string", "example": "US,DE" }, "description": "ISO 3166-1 alpha-2 country code; comma-separated values are ORed" },
          { "name": "technology", "in": "query", "schema": { "type": "string", "example": "SAP,Teamcenter" }, "description": "Case-insensitive exact match against extracted, normalized technologies; comma-separated values are ORed" },
          { "name": "ats", "in": "query", "schema": { "type": "string", "example": "workday,greenhouse" }, "description": "Source platform slug; comma-separated values are ORed. `bundesagentur` is accepted as a public alias for `bundesanstellung` only when used alone." },
          { "name": "category", "in": "query", "schema": { "type": "string", "example": "Technology,Sales" }, "description": "Comma-separated values are ORed" },
          { "name": "seniority", "in": "query", "schema": { "type": "string", "example": "mid,senior" }, "description": "Comma-separated values are ORed" },
          { "name": "remote", "in": "query", "schema": { "type": "string", "example": "remote,hybrid" }, "description": "remote, hybrid or onsite; comma-separated values are ORed" },
          { "name": "language", "in": "query", "schema": { "type": "string", "example": "en,it" }, "description": "Comma-separated values are ORed" },
          { "name": "q", "in": "query", "schema": { "type": "string", "example": "MBSE SysML" }, "description": "Full-text search over job title and description; all terms are required (AND)" },
          { "name": "q_any", "in": "query", "schema": { "type": "string", "example": "MBSE,SysML,CATIA" }, "description": "At least one comma-separated keyword must match the title or description (OR); maximum 15 keywords. Can be combined with q." },
          { "name": "title", "in": "query", "schema": { "type": "string", "example": "systems engineer" }, "description": "Full-text search restricted to the job title; all terms are required (AND)" },
          { "name": "posted_after", "in": "query", "schema": { "type": "string", "example": "2026-10-24T00:00:00Z" }, "description": "Posted at or after this ISO 8601 date/timestamp (inclusive)" },
          { "name": "posted_before", "in": "query", "schema": { "type": "string", "example": "2026-11-24T00:00:00Z" }, "description": "Posted strictly before this ISO 8601 date/timestamp (exclusive)" },
          { "$ref": "#/components/parameters/PageLimit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": { "description": "A page of postings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/companies": {
      "get": {
        "summary": "Search company records",
        "operationId": "companies",
        "description": "Company records keyed by ATS + company_slug. q searches the company name. country filters the company record, not each posting location. technology filters the exported company-level technology aggregate.",
        "parameters": [
          { "name": "country", "in": "query", "schema": { "type": "string", "example": "DE" } },
          { "name": "industry", "in": "query", "schema": { "type": "string" }, "description": "Exact industry value" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Case-insensitive company-name search" },
          { "name": "technology", "in": "query", "schema": { "type": "string", "example": "Kubernetes" } },
          { "name": "employees_min", "in": "query", "schema": { "type": "integer", "example": 500 } },
          { "name": "employees_max", "in": "query", "schema": { "type": "integer", "example": 5000 } },
          { "$ref": "#/components/parameters/PageLimit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": { "description": "A page of companies", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompanyPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/companies/{piattaforma}/{slug}": {
      "get": {
        "summary": "Get one company record",
        "operationId": "companyDetail",
        "parameters": [
          { "name": "piattaforma", "in": "path", "required": true, "schema": { "type": "string" }, "description": "ATS/source identifier" },
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Employer slug within that ATS" }
        ],
        "responses": {
          "200": { "description": "The company record", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Company not found" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/changes": {
      "get": {
        "summary": "Delta feed: new, updated and closed events",
        "operationId": "changes",
        "description": "Delta history is retained for seven days. Direct keys require an account monthly tier of at least 200,000 credits; top-ups do not raise this entitlement. RapidAPI plans bypass the direct-account tier check. next_cursor paginates the current response; use an ISO timestamp from the previous sync for the next since value.",
        "parameters": [
          { "name": "since", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" }, "description": "ISO 8601 timestamp within retained history" },
          { "$ref": "#/components/parameters/PageLimit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": { "description": "A page of events", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePage" } } } },
          "400": { "description": "Missing/malformed since, invalid cursor, or expired retention window; retention errors require resync", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/ErrorResponse" }, { "$ref": "#/components/schemas/DeltaRetentionResponse" }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Direct account below the 200,000 credits/month delta tier" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/exports/latest": {
      "get": {
        "summary": "Get the latest export manifest",
        "operationId": "exportManifest",
        "description": "Returns metadata for the latest available export. The manifest endpoint does not require the 50,000-credit bulk-file tier, but it is authenticated and metered.",
        "responses": {
          "200": { "description": "Latest export manifest", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/exports/latest/{nome}": {
      "get": {
        "summary": "Download the latest available bulk export",
        "operationId": "exportFile",
        "description": "Downloads offerte or aziende as JSONL gzip. Direct keys require an account monthly tier of at least 50,000 credits; top-ups do not raise this entitlement. RapidAPI does not include bulk-file downloads.",
        "parameters": [{ "name": "nome", "in": "path", "required": true, "schema": { "type": "string", "enum": ["offerte", "aziende"] } }],
        "responses": {
          "200": { "description": "The gzip export", "content": { "application/gzip": { "schema": { "type": "string", "format": "binary" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Bulk tier missing, or RapidAPI channel" },
          "404": { "description": "Unknown export name or no export available" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/coverage": {
      "get": {
        "summary": "Coverage for documented fields",
        "operationId": "coverage",
        "description": "Returns percentages from 0 to 100 for the documented set of posting and company fields measured in the latest export; it is not a schema of every response field.",
        "responses": {
          "200": { "description": "Field coverage percentages", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Get current credit usage",
        "operationId": "usage",
        "description": "Direct-account usage is shared across keys, including revoked keys. Monthly allowance is spent before purchased credits. This endpoint itself consumes one credit and returns 429 at a zero balance. RapidAPI returns a channel note because its quotas are managed by RapidAPI.",
        "responses": {
          "200": { "description": "Direct usage or RapidAPI channel note", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/Usage" }, { "$ref": "#/components/schemas/RapidApiUsage" }] } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/CreditsExhausted" },
          "503": { "$ref": "#/components/responses/CounterUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-Api-Key", "description": "Direct Nivult API key. RapidAPI users authenticate through the RapidAPI proxy instead." }
    },
    "parameters": {
      "PageLimit": { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100, "minimum": 1, "maximum": 500 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" }, "description": "Opaque keyset cursor from next_cursor" }
    },
    "responses": {
      "BadRequest": { "description": "Invalid date or cursor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Unauthorized": { "description": "Missing, invalid or revoked API key" },
      "ValidationError": { "description": "FastAPI parameter validation failed, for example limit=0 or a non-integer limit", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } } },
      "CreditsExhausted": { "description": "Monthly and purchased credits exhausted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreditError" } } } },
      "CounterUnavailable": { "description": "Credit counter or database temporarily unavailable, including query timeout; the response is JSON and no credit is charged", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "schemas": {
      "JobPage": { "$ref": "#/components/schemas/Page" },
      "CompanyPage": { "$ref": "#/components/schemas/Page" },
      "ChangePage": { "$ref": "#/components/schemas/Page" },
      "Page": {
        "type": "object",
        "required": ["data", "next_cursor", "count_page"],
        "properties": {
          "data": { "type": "array", "items": { "type": "object" } },
          "next_cursor": { "type": ["string", "null"] },
          "count_page": { "type": "integer" }
        }
      },
      "ErrorResponse": { "type": "object", "required": ["detail"], "properties": { "detail": { "type": "string" } } },
      "ValidationErrorResponse": { "type": "object", "required": ["detail"], "properties": { "detail": { "type": "array", "items": { "type": "object" } } } },
      "CreditError": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "object",
            "properties": {
              "error": { "type": "string", "example": "monthly and purchased credits exhausted" },
              "monthly_credits": { "type": "integer" },
              "purchased_credits": { "type": "integer" },
              "usage_month": { "type": "string", "format": "date" }
            }
          }
        }
      },
      "DeltaRetentionResponse": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "delta_retention_exceeded" },
              "error": { "type": "string", "example": "delta_retention_exceeded" },
              "message": { "type": "string" },
              "since": { "type": "string", "format": "date-time" },
              "retention_since": { "type": "string", "format": "date-time" },
              "action": { "type": "string", "example": "resync" },
              "resync_required": { "type": "boolean", "example": true }
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": ["monthly_credits", "used", "remaining", "usage_month", "monthly_remaining", "purchased_credits", "balance", "key_credits_used", "account_monthly_credits"],
        "properties": {
          "monthly_credits": { "type": "integer" },
          "used": { "type": "integer" },
          "remaining": { "type": "integer", "description": "Total remaining credits, including purchased credits" },
          "usage_month": { "type": "string", "format": "date" },
          "monthly_remaining": { "type": "integer" },
          "purchased_credits": { "type": "integer" },
          "balance": { "type": "integer", "description": "Same total balance as remaining" },
          "key_credits_used": { "type": "integer" },
          "account_monthly_credits": { "type": "integer" }
        }
      },
      "RapidApiUsage": {
        "type": "object",
        "properties": { "via": { "type": "string", "example": "rapidapi" }, "note": { "type": "string" } }
      }
    }
  }
}
