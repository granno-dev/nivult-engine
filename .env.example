# Copiare in .env e compilare. Il .env non entra mai nel repo.
# Sul server la stringa di connessione reale sta in /opt/nivult/.env

# Postgres ascolta solo su 127.0.0.1: dall'esterno serve un tunnel SSH
#   ssh -L 5432:127.0.0.1:5432 <utente>@<host>
# L'applicazione usa il ruolo nivult_app (solo DML).
DATABASE_URL=postgresql://nivult_app:CAMBIAMI@127.0.0.1:5432/nivult
# Solo il runner di migrazioni usa questa (ruolo con DDL).
MIGRATOR_DATABASE_URL=postgresql://nivult_migrator:CAMBIAMI@127.0.0.1:5432/nivult

# Fonti
FANTASTIC_API_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
BUNDESAGENTUR_API_KEY=
ARBETSFORMEDLINGEN_API_KEY=
NAV_API_KEY=
TYOMARKKINATORI_API_KEY=

# Inferenza
GLM_API_KEY=
GLM_BASE_URL=

# Consegna
SMTP_URL=
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
