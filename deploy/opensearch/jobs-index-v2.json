{
  "settings": {
    "index": {
      "number_of_shards": 2,
      "number_of_replicas": 0,
      "codec": "default",
      "refresh_interval": "-1",
      "translog.flush_threshold_size": "1gb",
      "sort.field": ["posted_at", "id"],
      "sort.order": ["desc", "desc"],
      "sort.missing": ["_last", "_last"]
    },
    "analysis": {
      "normalizer": {
        "nivult_lowercase": {
          "type": "custom",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,
    "_source": {
      "enabled": true
    },
    "properties": {
      "id": { "type": "keyword" },
      "title": { "type": "text" },
      "description": { "type": "text" },
      "country": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "category": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "ats": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "seniority": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "remote": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "language": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "technologies": { "type": "keyword", "normalizer": "nivult_lowercase" },
      "posted_at": { "type": "date", "ignore_malformed": true },
      "source_type": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 64 },
      "company": {
        "type": "text",
        "fields": {
          "keyword": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 256 }
        }
      },
      "company_slug": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 256 },
      "company_domain": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 256 },
      "city": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 256 },
      "state": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 256 },
      "employment_type": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 128 },
      "department": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 256 },
      "skills": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 128 },
      "has_salary": { "type": "boolean" },
      "salary_min": { "type": "double", "ignore_malformed": true },
      "salary_max": { "type": "double", "ignore_malformed": true },
      "salary_currency": { "type": "keyword", "normalizer": "nivult_lowercase", "ignore_above": 16 }
    }
  }
}
