// Nivult — solo aggiornamenti di sicurezza, riavvio alle 04:00.
// Questo file viene letto dopo 50unattended-upgrades e ne sovrascrive i valori.

#clear Unattended-Upgrade::Allowed-Origins;

// Solo i canali security. La riga "${distro_id}:${distro_codename}" del file
// predefinito prendeva TUTTO l'archivio noble, aggiornamenti di funzionalità
// compresi: su una macchina di produzione è un rischio non necessario.
Unattended-Upgrade::Allowed-Origins {
	"${distro_id}:${distro_codename}-security";
	"${distro_id}ESMApps:${distro_codename}-apps-security";
	"${distro_id}ESM:${distro_codename}-infra-security";
};

// Riavvio automatico quando un aggiornamento lo richiede, alle 04:00.
// Dopo la finestra di backup delle 03:00: un riavvio a metà dump lascerebbe
// un backup troncato. Il runner di migrazioni e i job a lotti sono
// riprendibili, quindi un riavvio in quella finestra non perde lavoro.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:00";

// Le vecchie dipendenze inutilizzate vanno rimosse: su 75 GB non è il disco
// il problema, sono i pacchetti non aggiornati che restano installati.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

Unattended-Upgrade::SyslogEnable "true";
