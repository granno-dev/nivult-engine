{
  "title": "Global Job Postings — input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tipo": {
      "title": "What do you need?",
      "type": "string",
      "enum": ["jobs", "companies"],
      "enumTitles": ["Job postings", "Companies (enriched employer records)"],
      "default": "jobs"
    },
    "country": {
      "title": "Country (ISO-2)",
      "type": "string",
      "description": "e.g. IT, DE, US — leave empty for worldwide",
      "editor": "textfield"
    },
    "technology": {
      "title": "Technology",
      "type": "string",
      "description": "e.g. SAP, Snowflake, Kubernetes — postings mentioning it in the text",
      "editor": "textfield"
    },
    "q": {
      "title": "Keyword",
      "type": "string",
      "description": "free text in title and description",
      "editor": "textfield"
    },
    "seniority": {
      "title": "Seniority",
      "type": "string",
      "enum": ["", "intern", "junior", "mid", "senior", "lead", "head"],
      "enumTitles": ["any", "intern", "junior", "mid", "senior", "lead", "head"],
      "default": ""
    },
    "remote": {
      "title": "Workplace",
      "type": "string",
      "enum": ["", "remote", "hybrid", "onsite"],
      "enumTitles": ["any", "remote", "hybrid", "on site"],
      "default": ""
    },
    "dal": {
      "title": "Posted after",
      "type": "string",
      "description": "ISO date, e.g. 2026-10-01 — only fresher postings",
      "editor": "textfield"
    },
    "limite": {
      "title": "Max results",
      "type": "integer",
      "description": "1–10,000 (for bigger slices ask about the daily full export)",
      "default": 100,
      "minimum": 1,
      "maximum": 10000
    }
  }
}
